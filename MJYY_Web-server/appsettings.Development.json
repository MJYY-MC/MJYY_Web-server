{
  "SerilogConfig": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Debug",
          "Microsoft.AspNetCore": "Debug",
          "Microsoft.Hosting.Lifetime": "Debug",
          "System": "Debug"
        }
      }
    }
  },
  "Config": {
    "Cors": {
      "Origins": [
        "http://localhost:5173",
        "http://localhost:4173"
      ]
    },
    "ApiKey": {
      "Enable": true,
      "Keys": {
        "test": "test-key"
      },
      "Targets": [
        {
          "Enable": false,
          "UrlStart": "/api",
          "KeyName": "test"
        },
        {
          "UrlStart": "/gateway",
          "KeyName": "test"
        },
        {
          "Enable": false,
          "UrlStart": "/swagger"
        }
      ]
    },
    "Gateway": {
      "Target": [
        {
          "Name": "mjyy",
          "Url": "https://mjyy.top",
          "ResultType": "json"
        },
        {
          "Name": "mjyy2",
          "Url": "https://mjyy.top",
          "ResultType": "iframe"
        },
        {
          "Name": "minecraft_messagepage",
          "Url": "",
          "ResultType": "json",
          "Password": {
            "Enable": true,
            "Value": "testpw"
          },
          "Parameters": [
            {
              "Name": "passkey",
              "Value": "test"
            }
          ]
        }
      ]
    }
  }
}
