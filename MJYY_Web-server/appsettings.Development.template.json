{
    "SerilogConfig": {
        "Serilog": {
            "MinimumLevel": {
                "Default": "Debug",
                "Override": {
                    "Microsoft": "Debug",
                    "Microsoft.AspNetCore": "Debug",
                    "Microsoft.Hosting.Lifetime": "Debug",
                    "System": "Debug"
                }
            }
        }
    },
    "Config": {
        "Server": {
            "Url": "https://localhost:7172",
            "PathBase": "/test",
            "UseXFFRequestHeader": false
        },
        "Cors": {
            "Origins": [
                "http://localhost:5173",
                "http://localhost:4173"
            ]
        },
        "ApiKey": {
            "Enable": true,
            "Keys": {
                "test": "test-key"
            },
            "Targets": [
                {
                    "Enable": false,
                    "UrlStart": "/api",
                    "KeyName": "test"
                },
                {
                    "UrlStart": "/gateway",
                    "KeyName": "test"
                },
                {
                    "Enable": false,
                    "UrlStart": "/swagger"
                }
            ]
        },
      "Gateway": {
        "ReuseValue": {
          "test1": "test12345",
          "test2": "test23456"
        },
        "Password": {
          "Lock": {
            "Enable": true,
            "LockBaseTime": 30,
            "LockTimeMultiple": 2,
            "LockCountOfFail": 5,
            "LockCountOfFailAgain": 2
          }
        },
        "Target": [
          {
            "Name": "testmjyy",
            "Url": "https://mjyy.top",
            "ResultType": "json"
          },
          {
            "Name": "testmjyy2",
            "Url": "https://mjyy.top",
            "ResultType": "iframe"
          },
          {
            "Name": "test",
            "Url": "https://example.com/",
            "ResultType": "json",
            "Password": {
              "Enable": true,
              "Value": "testpw"
            },
            "Parameters": [
              {
                "Name": "test_para",
                "Value": "test"
              }
            ]
          },
          {
            "Name": "test2",
            "Url": "https://example.com/",
            "ResultType": "json",
            "Password": {
              "Enable": true,
              "Value": "test1",
              "UseReuseValue": true
            },
            "Parameters": [
              {
                "Name": "test_para",
                "Value": "test2",
                "UseReuseValue": true
              }
            ]
          }
        ]
      }
    }
}