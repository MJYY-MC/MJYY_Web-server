{
    "SerilogConfig": {
        "Serilog": {
            "MinimumLevel": {
                "Default": "Debug",
                "Override": {
                    "Microsoft": "Debug",
                    "Microsoft.AspNetCore": "Debug",
                    "Microsoft.Hosting.Lifetime": "Debug",
                    "System": "Debug"
                }
            }
        }
    },
    "Config": {
        "Server": {
            "Url": "https://localhost:7172",
            "PathBase": "/test",
            "UseXFFRequestHeader": false
        },
        "Cors": {
            "Origins": [
                "http://localhost:5173",
                "http://localhost:4173"
            ]
        },
        "ApiKey": {
            "Enable": true,
            "Keys": {
                "test": "test-key"
            },
            "Targets": [
                {
                    "Enable": false,
                    "UrlStart": "/api",
                    "KeyName": "test"
                },
                {
                    "UrlStart": "/gateway",
                    "KeyName": "test"
                },
                {
                    "Enable": false,
                    "UrlStart": "/swagger"
                }
            ]
        },
        "Gateway": {
            "Target": [
                {
                    "Name": "testmjyy",
                    "Url": "https://mjyy.top",
                    "ResultType": "json"
                },
                {
                    "Name": "testmjyy2",
                    "Url": "https://mjyy.top",
                    "ResultType": "iframe"
                },
                {
                    "Name": "test",
                    "Url": "",
                    "ResultType": "json",
                    "Password": {
                        "Enable": true,
                        "Value": "testpw"
                    },
                    "Parameters": [
                        {
                            "Name": "passkey",
                            "Value": "test"
                        }
                    ]
                }
            ]
        }
    }
}